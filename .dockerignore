# Files that "docker build ." does not send to the builder. The build needs
# only the Go source, go.mod and go.sum. Patterns start at the repository root.

# Git and CI
.git/
.gitignore
.github/

# Environment files. They can hold passwords.
.env
.env.*

# Build output
/email-mcp
/email-mcp-go
bin/
dist/
*.exe
*.test
*.out

# TLS files of the interop test servers
test/interop/certs/

# Editors, notes and docs
.idea/
.vscode/
.superpowers/
docs/
*.md
*.swp
*~
.DS_Store

# Temporary files
tmp/
temp/
*.log
