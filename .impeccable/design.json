  "components": [
    {
      "name": "Neutral Button",
      "kind": "button",
      "refersTo": "button",
      "description": "The default button. Reject uses it.",
      "html": "<button class=\"ds-btn\" type=\"button\">Reject</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:8px 16px;border-radius:var(--radius,8px);cursor:pointer;font:500 0.9375rem/1.25 system-ui,sans-serif;transition:background-color 150ms cubic-bezier(0.16,1,0.3,1),border-color 150ms cubic-bezier(0.16,1,0.3,1),transform 100ms cubic-bezier(0.16,1,0.3,1);border:1px solid var(--line-strong,#8a958f);background:var(--pane,#fff);color:var(--ink,#16201c);}.ds-btn:active{transform:scale(0.98);}.ds-btn:focus-visible{outline:2px solid var(--go,#0b6b4f);outline-offset:2px;}.ds-btn:hover{background:var(--hover,#edf1ed);}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The action the person most likely wants next.",
      "html": "<button class=\"ds-btn-primary\" type=\"button\">Approve and send</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:8px 16px;border-radius:var(--radius,8px);cursor:pointer;font:500 0.9375rem/1.25 system-ui,sans-serif;transition:background-color 150ms cubic-bezier(0.16,1,0.3,1),border-color 150ms cubic-bezier(0.16,1,0.3,1),transform 100ms cubic-bezier(0.16,1,0.3,1);border:1px solid var(--go,#0b6b4f);background:var(--go,#0b6b4f);color:var(--go-ink,#fff);font-weight:600;}.ds-btn-primary:active{transform:scale(0.98);}.ds-btn-primary:focus-visible{outline:2px solid var(--go,#0b6b4f);outline-offset:2px;}.ds-btn-primary:hover{border-color:var(--go-hover,#085a42);background:var(--go-hover,#085a42);}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "The final destructive button, after a confirmation tick box.",
      "html": "<button class=\"ds-btn-danger\" type=\"button\">Remove account</button>",
      "css": ".ds-btn-danger{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:8px 16px;border-radius:var(--radius,8px);cursor:pointer;font:500 0.9375rem/1.25 system-ui,sans-serif;transition:background-color 150ms cubic-bezier(0.16,1,0.3,1),border-color 150ms cubic-bezier(0.16,1,0.3,1),transform 100ms cubic-bezier(0.16,1,0.3,1);border:1px solid var(--bad,#b3261e);background:var(--bad,#b3261e);color:var(--bad-ink,#fff);font-weight:600;}.ds-btn-danger:active{transform:scale(0.98);}.ds-btn-danger:focus-visible{outline:2px solid var(--go,#0b6b4f);outline-offset:2px;}.ds-btn-danger:hover{border-color:var(--bad-hover,#93201a);background:var(--bad-hover,#93201a);}"
    },
    {
      "name": "Quiet Danger Button",
      "kind": "button",
      "refersTo": "button-danger-quiet",
      "description": "A destructive action in a table row.",
      "html": "<button class=\"ds-btn-quiet\" type=\"button\">Revoke</button>",
      "css": ".ds-btn-quiet{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:8px 16px;border-radius:var(--radius,8px);cursor:pointer;font:500 0.9375rem/1.25 system-ui,sans-serif;transition:background-color 150ms cubic-bezier(0.16,1,0.3,1),border-color 150ms cubic-bezier(0.16,1,0.3,1),transform 100ms cubic-bezier(0.16,1,0.3,1);min-height:34px;padding:4px 12px;border:1px solid var(--line-strong,#8a958f);background:var(--pane,#fff);color:var(--bad-text,#a4231c);}.ds-btn-quiet:active{transform:scale(0.98);}.ds-btn-quiet:focus-visible{outline:2px solid var(--go,#0b6b4f);outline-offset:2px;}.ds-btn-quiet:hover{background:var(--hover,#edf1ed);}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "A labelled input. The label sits above it.",
      "html": "<div class=\"ds-field\"><label class=\"ds-label\" for=\"ds-name\">Name</label><input class=\"ds-input\" id=\"ds-name\" value=\"Laptop agent\"></div>",
      "css": ".ds-label{display:block;margin-bottom:4px;font:500 0.9375rem/1.55 system-ui,sans-serif;color:var(--ink,#16201c);}.ds-input{width:100%;min-height:40px;padding:7px 10px;border:1px solid var(--line-strong,#8a958f);border-radius:var(--radius,8px);background:var(--pane,#fff);color:var(--ink,#16201c);font:400 1rem/1.55 system-ui,sans-serif;transition:border-color 150ms cubic-bezier(0.16,1,0.3,1);}.ds-input:hover{border-color:var(--soft,#55615b);}.ds-input:focus-visible{border-color:var(--go,#0b6b4f);outline:2px solid var(--go,#0b6b4f);outline-offset:0;}"
    },
    {
      "name": "Main Menu",
      "kind": "nav",
      "refersTo": "menu-link",
      "description": "The left menu, with the current place and the waiting count.",
      "html": "<nav class=\"ds-menu\" aria-label=\"Main menu\"><a class=\"ds-menu-link\" href=\"#\" aria-current=\"page\"><span>Waiting for you</span><span class=\"ds-count\">5</span></a><a class=\"ds-menu-link\" href=\"#\">Accounts</a><a class=\"ds-menu-link\" href=\"#\">Activity</a></nav>",
      "css": ".ds-menu{display:flex;flex-direction:column;gap:2px;width:224px;padding:12px;background:var(--ground,#f4f6f3);}.ds-menu-link{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:8px 10px;border-radius:var(--radius,8px);color:var(--soft,#55615b);font:400 1rem/1.55 system-ui,sans-serif;text-decoration:none;transition:background-color 150ms cubic-bezier(0.16,1,0.3,1),color 150ms cubic-bezier(0.16,1,0.3,1);}.ds-menu-link:hover{background:var(--hover,#edf1ed);color:var(--ink,#16201c);}.ds-menu-link:focus-visible{outline:2px solid var(--go,#0b6b4f);outline-offset:2px;}.ds-menu-link[aria-current]{background:var(--go-soft,#e2eee8);color:var(--go-text,#0b6b4f);font-weight:600;}.ds-count{min-width:1.5em;border-radius:999px;background:var(--go,#0b6b4f);color:var(--go-ink,#fff);font-size:0.8125rem;font-weight:600;font-variant-numeric:tabular-nums;line-height:1.5em;text-align:center;}"
    },
    {
      "name": "Waiting Item",
      "kind": "custom",
      "refersTo": "queue-item",
      "description": "One held action in the waiting list. It is a row, not a card.",
      "html": "<a class=\"ds-queue\" href=\"#\" aria-current=\"true\"><span class=\"ds-queue-title\">Invoice 4471 for October</span><span class=\"ds-queue-line\">To 3 people</span><span class=\"ds-queue-foot\"><span>person@mail.example</span><span>23 h left</span></span></a>",
      "css": ".ds-queue{display:block;width:340px;max-width:100%;padding:12px 20px;border-top:1px solid var(--line,#dde2de);color:var(--ink,#16201c);font:400 1rem/1.55 system-ui,sans-serif;text-decoration:none;transition:background-color 150ms cubic-bezier(0.16,1,0.3,1);}.ds-queue:hover{background:var(--hover,#edf1ed);}.ds-queue:focus-visible{outline:2px solid var(--go,#0b6b4f);outline-offset:-2px;}.ds-queue[aria-current]{background:var(--go-soft,#e2eee8);}.ds-queue-title,.ds-queue-line{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}.ds-queue-title{font-weight:600;}.ds-queue-line{color:var(--soft,#55615b);font-size:0.875rem;}.ds-queue-foot{display:flex;justify-content:space-between;gap:12px;margin-top:2px;color:var(--soft,#55615b);font-size:0.8125rem;font-variant-numeric:tabular-nums;}"
    },
    {
      "name": "Approval Bar",
      "kind": "custom",
      "refersTo": "action-bar",
      "description": "The signature decision bar, with its note and buttons, shown while the send is working.",
      "html": "<div class=\"ds-bar\"><p class=\"ds-bar-note\"></p><div class=\"ds-bar-buttons\"><button class=\"ds-bar-btn ds-locked\" type=\"button\" aria-disabled=\"true\">Reject</button><button class=\"ds-bar-btn ds-bar-go ds-busy\" type=\"button\" aria-disabled=\"true\">Sending…</button></div></div>",
      "css": ".ds-bar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px 20px;padding:14px 0;border-bottom:1px solid var(--line,#dde2de);background:var(--pane,#fff);}.ds-bar-note{flex:1 1 12rem;margin:0;color:var(--soft,#55615b);font:400 0.9375rem/1.55 system-ui,sans-serif;}.ds-bar-buttons{display:flex;flex-wrap:wrap;gap:8px;}.ds-bar-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:8px 16px;border:1px solid var(--line-strong,#8a958f);border-radius:var(--radius,8px);background:var(--pane,#fff);color:var(--ink,#16201c);cursor:progress;font:500 0.9375rem/1.25 system-ui,sans-serif;}.ds-bar-go{border-color:var(--go,#0b6b4f);background:var(--go,#0b6b4f);color:var(--go-ink,#fff);font-weight:600;}.ds-locked{opacity:0.55;}.ds-busy::before{width:15px;height:15px;border:2px solid currentcolor;border-top-color:transparent;border-radius:50%;animation:ds-spin 700ms linear infinite;content:\"\";}@keyframes ds-spin{to{transform:rotate(360deg);}}"
    },
    {
      "name": "Result",
      "kind": "custom",
      "refersTo": "outcome-mark-good",
      "description": "The signature result: a mark that comes in with the answer, the true headline, and the next action.",
      "html": "<section class=\"ds-out\"><div class=\"ds-out-head\"><span class=\"ds-out-mark\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg></span><h2 class=\"ds-out-title\">Sent</h2></div><p class=\"ds-out-text\">The mail server accepted the message.</p></section>",
      "css": ".ds-out{max-width:34rem;padding:32px 0;color:var(--ink,#16201c);font:400 1rem/1.55 system-ui,sans-serif;}.ds-out-head{display:flex;align-items:center;gap:14px;margin-bottom:16px;}.ds-out-title{margin:0;font-size:1.625rem;font-weight:650;line-height:1.25;letter-spacing:-0.02em;}.ds-out-mark{display:inline-grid;flex:none;width:44px;height:44px;border-radius:50%;background:var(--go,#0b6b4f);color:var(--go-ink,#fff);place-items:center;animation:ds-mark-in 320ms cubic-bezier(0.16,1,0.3,1);}.ds-out-mark svg{width:24px;height:24px;fill:none;stroke:currentcolor;stroke-linecap:round;stroke-linejoin:round;stroke-width:2.5;}.ds-out-text{margin:0;}@keyframes ds-mark-in{from{opacity:0;transform:scale(0.7);}}"
    },
    {
      "name": "Neutral Notice",
      "kind": "card",
      "refersTo": "notice",
      "description": "An ordinary message with no risk.",
      "html": "<div class=\"ds-notice-plain\">No server settings were found for this address. Enter them yourself.</div>",
      "css": ".ds-notice-plain{padding:12px 16px;border:1px solid var(--line,#dde2de);border-radius:var(--radius-large,12px);background:var(--info-soft,#e9eef0);color:var(--ink,#16201c);font:400 1rem/1.55 system-ui,sans-serif;}"
    },
    {
      "name": "Warning Notice",
      "kind": "card",
      "refersTo": "notice-warn",
      "description": "An amber notice for real risk. Its text stays exact.",
      "html": "<div class=\"ds-notice\"><strong>Full autonomy</strong><p>With both confirmations off, the agent acts without asking you.</p></div>",
      "css": ".ds-notice{padding:12px 16px;border:1px solid var(--warn-line,#e6d29d);border-radius:var(--radius-large,12px);background:var(--warn-soft,#fbf1d9);color:var(--warn-ink,#5c4300);font:400 1rem/1.55 system-ui,sans-serif;}.ds-notice p{margin:0;}"
    }
  ],
  "narrative": {
    "northStar": "The Held Mail",
    "overview": "The portal is a small mail app with one folder. That folder holds the actions the agent wants, and each one stays held until the person decides. The person sees what waits, reads the whole action, decides, sees at once that the click works, and then sees the true result. Every surface serves that sequence, and setup comes second.\n\nThe look is calm and dense in the way a mail client is dense: a slightly tinted ground, white reading panes, thin rules between things, and very little colour. Colour carries meaning here and never decoration. Green says where you are and what to do next. Red and amber appear for real risk. Everything else is ink on a pane.\n\nThe system rejects the admin panel: on a desktop screen there is no top bar, and no table or setup page comes first. It is also flat, with no shadow anywhere, and it is self-contained. All of it ships inside the binary, so what you see depends on nothing from another site.",
    "keyCharacteristics": [
      "Three panes on a wide screen: menu, waiting list, open action.",
      "The decision buttons stay at the top of the open action, and at the bottom of the screen on a phone.",
      "One green, and a closed list of places where it may appear.",
      "Thin rules separate content. Boxes are for notices.",
      "No shadows, no gradients, no uppercase labels.",
      "Light and dark follow the setting of the computer."
    ],
    "rules": [
      {
        "name": "The One Green Rule",
        "body": "Green marks the primary action and the current place. Other uses are a closed list: the waiting count that leads to the primary action, proof that something worked (the good result mark, the connected status, the new-token notice), and the standard controls of the page (links, focus ring, checkbox tick, text selection). Do not add to this list. Green is never decoration, and it is never a section tint.",
        "section": "colors"
      },
      {
        "name": "The Real Risk Rule",
        "body": "Red and amber mark real risk only: a destructive action, a failed result or error, a missing part of a message, an unencrypted connection, a certificate problem, suggested server settings that need checking, a request to change a permission, an account that needs attention, or full autonomy. Only real risk looks alarming, so a normal screen has no red and no amber. An ordinary message uses the neutral notice.",
        "section": "colors"
      },
      {
        "name": "The Quiet Failure Rule",
        "body": "A failed result has a neutral Next button, never a green one. The Next button is green only after a result that did not fail, because a failure must not push the person on. A failed result is never styled like a success.",
        "section": "colors"
      },
      {
        "name": "The Computer's Own Fonts Rule",
        "body": "The portal uses system fonts only. There are no web fonts, no font files, and no CDN (content delivery network, a set of external file servers). Everything is inside the binary.",
        "section": "typography"
      },
      {
        "name": "The 34rem Rule",
        "body": "Reading text is limited to 34rem wide, not a number of `ch` units, because `ch` is too wide in this font. Message bodies, sheet paragraphs, and the sentences of a result follow it. Headers and lists may run to 44rem, because their lines are short.",
        "section": "typography"
      },
      {
        "name": "The Decision Stays Reachable Rule",
        "body": "While an action waits, its Reject and Approve buttons stay on screen at every length of message: fixed to the top of the reader, or to the bottom of a phone screen.",
        "section": "layout"
      },
      {
        "name": "The Flat Pane Rule",
        "body": "Nothing floats. If a surface needs to stand apart, it gets a tone change or a hairline.",
        "section": "elevation"
      },
      {
        "name": "The Rule, Not a Box Rule",
        "body": "A group in a form or a page is set off by a hairline above it, never by a card. A box with a background means a notice, so a box always carries a message to the person.",
        "section": "shapes"
      },
      {
        "name": "The True Result Rule",
        "body": "Text claims only what is always true. A busy label says what is being attempted, and only the result says what happened. Safety wording stays exact: never rephrase, shorten, or restyle away the full autonomy, certificate, or no encryption warnings.",
        "section": "components"
      },
      {
        "name": "The Plain Form Rule",
        "body": "Every form works without app.js. The script only shows that a form is working, and it never reads or sends anything by itself. No inline script and no inline style in the pages: all style lives in the one stylesheet, and the Content Security Policy blocks the rest.",
        "section": "components"
      }
    ],
    "dos": [
      "Do put what waits for the person first, and setup second.",
      "Do show the whole action before asking for a decision, and show Approve only when the page shows the whole action.",
      "Do keep green to The One Green Rule's closed list, and use each token with its night value.",
      "Do limit reading text to 34rem, and do not measure it in `ch`.",
      "Do separate groups with a hairline, and keep boxes for notices.",
      "Do give a button a busy label when its action can take time: the approval decisions and the connection tests have one.",
      "Do make the next action one click away after a result, in a neutral button if the result failed.",
      "Do say a state in words as well as in colour.",
      "Do use the 150ms curve of `cubic-bezier(0.16, 1, 0.3, 1)` for state changes."
    ],
    "donts": [
      "Don't add a top bar above 900px, or open with a table or a setup page. Below 900px the menu row at the top is the correct layout, and a table remains correct for a list with many columns.",
      "Don't use red for Reject. Rejecting is an ordinary decision, so its button stays neutral.",
      "Don't use amber or red to add emphasis, and don't use green to decorate.",
      "Don't give a failed result a green button or a success mark.",
      "Don't write a sentence that is only sometimes true, and don't change the wording of a safety warning.",
      "Don't add web fonts, font files, a CDN, or anything from another site.",
      "Don't add inline script or inline style, or a form that needs app.js to work.",
      "Don't add shadows, gradients, or backdrop blur.",
      "Don't add uppercase labels, eyebrow text above headings, or icon characters from a font. Icons are inline line drawings.",
      "Don't wrap groups or list rows in cards."
    ]
  }
}
