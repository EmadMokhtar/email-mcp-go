# IMAP Configuration
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your-email@gmail.com
IMAP_PASSWORD=your-app-password
IMAP_TLS=true

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true

# OAuth2 (optional, instead of a password).
# With USE_OAUTH=true all three OAUTH_ values are required, and IMAP_USERNAME
# and SMTP_USERNAME are the account the token belongs to. The server signs in
# with XOAUTH2 and refreshes the access token on its own.
USE_OAUTH=false
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REFRESH_TOKEN=
# Token endpoint. Leave empty for Google; set it for another provider.
OAUTH_TOKEN_URL=

# HTTP mode only (not used in stdio mode, which Claude Desktop uses).
# MCP_AUTH_TOKEN is required to start in HTTP mode: every request to /mcp must
# send it as "Authorization: Bearer <token>". Without it the email tools would
# be open to anything that can reach the port.
MCP_AUTH_TOKEN=
# Comma-separated browser origins allowed to call the server.
# Empty means no cross-origin access at all.
MCP_ALLOWED_ORIGINS=