# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
# Anchored to the repo root. An unanchored "email-mcp" would also match the
# cmd/email-mcp/ source directory and hide new files in it from git.
/email-mcp
/email-mcp-go
/bin/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html

# Dependency directories
vendor/

# Go workspace file
go.work

# Environment variables
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log

# Build artifacts
dist/
build/

# Temporary files
tmp/
temp/

# TLS files of the interop test servers. go run ./test/interop/gencerts makes
# them for each run. They are never committed.
/test/interop/certs/

# The docs site (see the Makefile). Hugo writes the built site to site/public/
# and its cache to site/resources/. The screenshots are made for each build and
# are never committed. site/static/icon.svg is a copy of the icon of the portal.
site/public/
site/resources/
site/.hugo_build.lock
site/assets/screenshots/
site/static/icon.svg
